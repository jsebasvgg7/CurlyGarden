rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMe(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function belongsToCouple(coupleId) {
      return isSignedIn()
        && myProfile().coupleId == coupleId;
    }

    function sharesCoupleWith(otherUser) {
      return isSignedIn()
        && myProfile().get('coupleId', null) != null
        && otherUser.get('coupleId', null) == myProfile().get('coupleId', null);
    }

    function isCreator(data) {
      return data.createdBy == request.auth.uid;
    }

    function canEditShared(data) {
      return isCreator(data)
        || (request.auth.uid in data.sharedWith && data.locked == false);
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function isJoin() {
      return !isCreator(resource.data)
        && resource.data.sharedWith.size() == 0
        && resource.data.locked == false
        && onlyChanges(['sharedWith'])
        && request.resource.data.sharedWith == [request.auth.uid];
    }

    function isLockToggle() {
      return isCreator(resource.data)
        && onlyChanges(['locked'])
        && request.resource.data.locked is bool;
    }

    function isLikeToggle() {
      let added = request.resource.data.likedBy.toSet().difference(resource.data.likedBy.toSet());
      let removed = resource.data.likedBy.toSet().difference(request.resource.data.likedBy.toSet());
      return onlyChanges(['likedBy'])
        && request.resource.data.likedBy is list
        && ((added.hasOnly([request.auth.uid]) && removed.size() == 0)
            || (removed.hasOnly([request.auth.uid]) && added.size() == 0));
    }

    function validTitle(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 80;
    }

    function validAttachment(data) {
      return !('attachmentUrl' in data)
        || (data.attachmentUrl is string && data.get('attachmentType', '') in ['image', 'file']);
    }

    function validIdea(data) {
      return validTitle(data)
        && data.content is string
        && data.content.size() > 0
        && data.content.size() <= 1000
        && validAttachment(data);
    }

    function validList(data) {
      return validTitle(data)
        && data.items is list
        && data.items.size() <= 100
        && data.status in ['activa', 'finalizada'];
    }

    function validGoal(data) {
      return validTitle(data)
        && data.content is string
        && data.content.size() <= 500
        && data.targetDateText is string
        && data.targetDateText.size() > 0
        && data.targetDateText.size() <= 60
        && data.status in ['activa', 'finalizada'];
    }

    function newSharedBase(data) {
      return isCreator(data)
        && data.sharedWith == []
        && data.locked == false
        && data.likedBy == []
        && data.createdAt == request.time;
    }

    function capsulePath(coupleId, capsuleId) {
      return /databases/$(database)/documents/couples/$(coupleId)/imagineCapsules/$(capsuleId);
    }

    function isContribution(coupleId, capsuleId) {
      return resource.data.mode == 'shared'
        && request.time < resource.data.unlockDate
        && !(request.auth.uid in resource.data.contributors)
        && onlyChanges(['contributors'])
        && request.resource.data.contributors == resource.data.contributors.concat([request.auth.uid])
        && existsAfter(/databases/$(database)/documents/couples/$(coupleId)/imagineCapsules/$(capsuleId)/entries/$(request.auth.uid));
    }

    function dailyPath(coupleId, date) {
      return /databases/$(database)/documents/couples/$(coupleId)/dailyChallenges/$(date);
    }

    function responsePath(coupleId, date, uid) {
      return /databases/$(database)/documents/couples/$(coupleId)/dailyChallenges/$(date)/responses/$(uid);
    }

    function sessionPath(coupleId, sessionId) {
      return /databases/$(database)/documents/couples/$(coupleId)/gameSessions/$(sessionId);
    }

    function validPicks(data) {
      return data.keys().hasOnly(['picks', 'createdAt'])
        && data.picks is list
        && data.picks.size() == 5
        && data.createdAt == request.time;
    }

    function isSessionAnswer(coupleId, sessionId) {
      let next = request.resource.data.answeredBy;
      return resource.data.status == 'answering'
        && onlyChanges(['answeredBy', 'status'])
        && !(request.auth.uid in resource.data.answeredBy)
        && next == resource.data.answeredBy.concat([request.auth.uid])
        && request.resource.data.status == (next.size() == 2
             ? (resource.data.type == 'thisOrThat' ? 'revealed' : 'guessing')
             : 'answering')
        && existsAfter(/databases/$(database)/documents/couples/$(coupleId)/gameSessions/$(sessionId)/answers/$(request.auth.uid));
    }

    function isSessionGuess(coupleId, sessionId) {
      let next = request.resource.data.guessedBy;
      return resource.data.status == 'guessing'
        && onlyChanges(['guessedBy', 'status'])
        && !(request.auth.uid in resource.data.guessedBy)
        && next == resource.data.guessedBy.concat([request.auth.uid])
        && request.resource.data.status == (next.size() == 2 ? 'revealed' : 'guessing')
        && existsAfter(/databases/$(database)/documents/couples/$(coupleId)/gameSessions/$(sessionId)/guesses/$(request.auth.uid));
    }

    function isSessionScore() {
      return resource.data.status == 'revealed'
        && resource.data.type == 'knowMe'
        && onlyChanges(['scored'])
        && !(request.auth.uid in resource.data.scored)
        && request.resource.data.scored == resource.data.scored.concat([request.auth.uid]);
    }

    match /users/{userId} {
      allow read: if isMe(userId) || sharesCoupleWith(resource.data);
      allow create: if isMe(userId);
      allow update: if isMe(userId)
        && request.resource.data.coupleId == resource.data.coupleId;
      allow delete: if false;
    }

    match /couples/{coupleId} {
      allow read: if belongsToCouple(coupleId);

      allow create: if isSignedIn()
        && request.resource.data.user1Id == request.auth.uid
        && request.resource.data.user2Id == ""
        && myProfile().coupleId == null;

      allow update: if belongsToCouple(coupleId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['streakLog'])
        && request.resource.data.streakLog is map;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if belongsToCouple(coupleId);

        allow create: if belongsToCouple(coupleId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 140
          && request.resource.data.seen == false
          && request.resource.data.timestamp == request.time
          && request.resource.data.keys().hasOnly(
               ['senderId', 'text', 'timestamp', 'seen', 'replyTo', 'replyPreview']
             )
          && (!('replyPreview' in request.resource.data)
              || (request.resource.data.replyPreview is string
                  && request.resource.data.replyPreview.size() <= 60));

        allow update: if belongsToCouple(coupleId)
          && resource.data.senderId != request.auth.uid
          && resource.data.seen == false
          && request.resource.data.seen == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen']);

        allow delete: if false;
      }

      match /drawRound/{roundId} {
        allow read, write: if belongsToCouple(coupleId);

        match /canvases/{slot} {
          allow read, write: if belongsToCouple(coupleId);
        }
      }

      match /drawHistory/{entryId} {
        allow read, create, update: if belongsToCouple(coupleId);
        allow delete: if false;
      }

      match /dailyChallenges/{date} {
        allow read: if belongsToCouple(coupleId);

        allow create: if belongsToCouple(coupleId)
          && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(
               ['type', 'bankIndex', 'status', 'answeredBy', 'createdAt']
             )
          && request.resource.data.type in ['question', 'action']
          && request.resource.data.bankIndex is int
          && request.resource.data.bankIndex >= 0
          && request.resource.data.status == 'open'
          && request.resource.data.answeredBy == [request.auth.uid]
          && request.resource.data.createdAt == request.time
          && existsAfter(responsePath(coupleId, date, request.auth.uid));

        allow update: if belongsToCouple(coupleId)
          && resource.data.status == 'open'
          && onlyChanges(['answeredBy', 'status'])
          && !(request.auth.uid in resource.data.answeredBy)
          && request.resource.data.answeredBy == resource.data.answeredBy.concat([request.auth.uid])
          && request.resource.data.answeredBy.size() == 2
          && request.resource.data.status == 'completed'
          && existsAfter(responsePath(coupleId, date, request.auth.uid));

        allow delete: if false;

        match /responses/{authorId} {
          allow read: if belongsToCouple(coupleId)
            && (authorId == request.auth.uid
                || get(dailyPath(coupleId, date)).data.status == 'completed');

          allow create: if belongsToCouple(coupleId)
            && authorId == request.auth.uid
            && request.auth.uid in getAfter(dailyPath(coupleId, date)).data.answeredBy
            && request.resource.data.keys().hasOnly(['text', 'createdAt'])
            && request.resource.data.createdAt == request.time
            && ('text' in request.resource.data
                ? (request.resource.data.text is string
                   && request.resource.data.text.size() > 0
                   && request.resource.data.text.size() <= 140)
                : getAfter(dailyPath(coupleId, date)).data.type == 'action');

          allow update, delete: if false;
        }
      }

      match /gameSessions/{sessionId} {
        allow read: if belongsToCouple(coupleId);

        allow create: if belongsToCouple(coupleId)
          && request.resource.data.keys().hasOnly(
               ['type', 'questionIds', 'status', 'answeredBy', 'guessedBy', 'scored', 'createdBy', 'createdAt']
             )
          && request.resource.data.type in ['thisOrThat', 'knowMe']
          && request.resource.data.questionIds is list
          && request.resource.data.questionIds.size() == 5
          && request.resource.data.status == 'answering'
          && request.resource.data.answeredBy == []
          && (request.resource.data.type == 'knowMe'
              ? (request.resource.data.guessedBy == [] && request.resource.data.scored == [])
              : !('guessedBy' in request.resource.data || 'scored' in request.resource.data))
          && isCreator(request.resource.data)
          && request.resource.data.createdAt == request.time;

        allow update: if belongsToCouple(coupleId)
          && (isSessionAnswer(coupleId, sessionId)
              || isSessionGuess(coupleId, sessionId)
              || isSessionScore());

        allow delete: if false;

        match /answers/{authorId} {
          allow read: if belongsToCouple(coupleId)
            && (authorId == request.auth.uid
                || get(sessionPath(coupleId, sessionId)).data.status == 'revealed');

          allow create: if belongsToCouple(coupleId)
            && authorId == request.auth.uid
            && get(sessionPath(coupleId, sessionId)).data.status == 'answering'
            && request.auth.uid in getAfter(sessionPath(coupleId, sessionId)).data.answeredBy
            && validPicks(request.resource.data);

          allow update, delete: if false;
        }

        match /guesses/{authorId} {
          allow read: if belongsToCouple(coupleId)
            && (authorId == request.auth.uid
                || get(sessionPath(coupleId, sessionId)).data.status == 'revealed');

          allow create: if belongsToCouple(coupleId)
            && authorId == request.auth.uid
            && get(sessionPath(coupleId, sessionId)).data.status == 'guessing'
            && request.auth.uid in getAfter(sessionPath(coupleId, sessionId)).data.guessedBy
            && validPicks(request.resource.data);

          allow update, delete: if false;
        }
      }

      match /playStats/{statsUid} {
        allow read: if belongsToCouple(coupleId);

        allow create: if belongsToCouple(coupleId)
          && statsUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['points'])
          && request.resource.data.points is int
          && request.resource.data.points >= 0
          && request.resource.data.points <= 25;

        allow update: if belongsToCouple(coupleId)
          && statsUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['points'])
          && request.resource.data.points is int
          && request.resource.data.points >= resource.data.points
          && request.resource.data.points <= resource.data.points + 25;

        allow delete: if false;
      }

      match /elevenStats/{statsUid} {
        allow read: if belongsToCouple(coupleId);

        allow create: if belongsToCouple(coupleId)
          && statsUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['count', 'lastDay', 'pressedAt'])
          && request.resource.data.keys().hasAll(['count', 'lastDay', 'pressedAt'])
          && request.resource.data.count == 1
          && request.resource.data.lastDay is string
          && request.resource.data.lastDay.size() == 10
          && request.resource.data.pressedAt == request.time;

        allow update: if belongsToCouple(coupleId)
          && statsUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['count', 'lastDay', 'pressedAt'])
          && request.resource.data.keys().hasAll(['count', 'lastDay', 'pressedAt'])
          && request.resource.data.count == resource.data.count + 1
          && request.resource.data.lastDay is string
          && request.resource.data.lastDay.size() == 10
          && request.resource.data.lastDay != resource.data.lastDay
          && request.resource.data.pressedAt == request.time
          && request.time > resource.data.pressedAt + duration.value(20, 'h');

        allow delete: if false;
      }

      match /imagineIdeas/{entryId} {
        allow read: if belongsToCouple(coupleId);

        allow create: if belongsToCouple(coupleId)
          && request.resource.data.keys().hasOnly(
               ['title', 'content', 'createdBy', 'sharedWith', 'locked', 'likedBy',
                'attachmentUrl', 'attachmentType', 'createdAt']
             )
          && newSharedBase(request.resource.data)
          && validIdea(request.resource.data);

        allow update: if belongsToCouple(coupleId)
          && (isJoin()
              || isLockToggle()
              || isLikeToggle()
              || (canEditShared(resource.data)
                  && onlyChanges(['title', 'content', 'attachmentUrl', 'attachmentType'])
                  && validIdea(request.resource.data)));

        allow delete: if belongsToCouple(coupleId) && isCreator(resource.data);
      }

      match /imagineLists/{entryId} {
        allow read: if belongsToCouple(coupleId);

        allow create: if belongsToCouple(coupleId)
          && request.resource.data.keys().hasOnly(
               ['title', 'items', 'createdBy', 'sharedWith', 'locked', 'likedBy',
                'status', 'createdAt']
             )
          && newSharedBase(request.resource.data)
          && request.resource.data.status == 'activa'
          && validList(request.resource.data);

        allow update: if belongsToCouple(coupleId)
          && (isJoin()
              || isLockToggle()
              || isLikeToggle()
              || (canEditShared(resource.data)
                  && onlyChanges(['title', 'items', 'status'])
                  && validList(request.resource.data)));

        allow delete: if belongsToCouple(coupleId) && isCreator(resource.data);
      }

      match /imagineGoals/{entryId} {
        allow read: if belongsToCouple(coupleId);

        allow create: if belongsToCouple(coupleId)
          && request.resource.data.keys().hasOnly(
               ['title', 'content', 'targetDateText', 'createdBy', 'sharedWith',
                'locked', 'likedBy', 'status', 'createdAt']
             )
          && newSharedBase(request.resource.data)
          && request.resource.data.status == 'activa'
          && validGoal(request.resource.data);

        allow update: if belongsToCouple(coupleId)
          && (isJoin()
              || isLockToggle()
              || isLikeToggle()
              || (canEditShared(resource.data)
                  && onlyChanges(['title', 'content', 'targetDateText', 'status'])
                  && validGoal(request.resource.data)));

        allow delete: if belongsToCouple(coupleId) && isCreator(resource.data);
      }

      match /imagineCapsules/{capsuleId} {
        allow read: if belongsToCouple(coupleId);

        allow create: if belongsToCouple(coupleId)
          && request.resource.data.keys().hasOnly(
               ['title', 'mode', 'unlockDate', 'contributors', 'createdBy', 'likedBy', 'createdAt']
             )
          && validTitle(request.resource.data)
          && request.resource.data.mode in ['individual', 'shared']
          && request.resource.data.unlockDate is timestamp
          && request.resource.data.unlockDate > request.time
          && isCreator(request.resource.data)
          && request.resource.data.contributors == [request.auth.uid]
          && request.resource.data.likedBy == []
          && request.resource.data.createdAt == request.time
          && existsAfter(/databases/$(database)/documents/couples/$(coupleId)/imagineCapsules/$(capsuleId)/entries/$(request.auth.uid));

        allow update: if belongsToCouple(coupleId)
          && (isLikeToggle() || isContribution(coupleId, capsuleId));

        allow delete: if false;

        match /entries/{authorId} {
          allow read: if belongsToCouple(coupleId)
            && (authorId == request.auth.uid
                || request.time >= get(capsulePath(coupleId, capsuleId)).data.unlockDate);

          allow create: if belongsToCouple(coupleId)
            && authorId == request.auth.uid
            && request.auth.uid in getAfter(capsulePath(coupleId, capsuleId)).data.contributors
            && request.time < getAfter(capsulePath(coupleId, capsuleId)).data.unlockDate
            && request.resource.data.keys().hasOnly(
                 ['text', 'attachmentUrl', 'attachmentType', 'createdAt']
               )
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 1000
            && request.resource.data.createdAt == request.time
            && validAttachment(request.resource.data);

          allow update, delete: if false;
        }
      }

      match /memories/{memoryId} {
        allow read: if belongsToCouple(coupleId);
        allow create: if belongsToCouple(coupleId)
          && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if belongsToCouple(coupleId);
      }

      match /albums/{albumId} {
        allow read: if belongsToCouple(coupleId);
        allow write: if belongsToCouple(coupleId);
      }
    }

    match /inviteCodes/{code} {
      allow read: if isSignedIn() && resource.data.createdBy == request.auth.uid;
      allow write: if false;
    }
  }
}
